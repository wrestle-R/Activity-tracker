# Existing Personal Supabase project. Never commit real keys.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLIC_PUBLISHABLE_KEY

# Optional server endpoint that imports a linked Strava activity. Never expose
# a Strava client secret or long-lived access token in the mobile app.
EXPO_PUBLIC_STRAVA_IMPORT_URL=https://your-api.example/strava/activity
